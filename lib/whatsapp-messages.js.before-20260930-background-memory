  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(label + ' HTTP ' + response.status + ': ' + (typeof data === 'string' ? data : JSON.stringify(data || {})).slice(0, 240));
  return Array.isArray(data) ? data : [];
}
